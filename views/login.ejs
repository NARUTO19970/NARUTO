<!DOCTYPE html>
<html>

<head>

<title>Login</title>

<style>

body{
margin:0;
font-family:Arial;
background:#075E54;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
}

.login-box{
background:white;
padding:30px;
width:320px;
border-radius:15px;
box-shadow:0 5px 20px rgba(0,0,0,0.3);
}

h2{
text-align:center;
margin-bottom:20px;
}

input{
width:100%;
padding:12px;
margin:10px 0;
border:1px solid #999;
border-radius:10px;
outline:none;
font-size:15px;
box-sizing:border-box;
}

button{
width:100%;
padding:12px;
background:#075E54;
color:white;
border:none;
border-radius:10px;
font-size:16px;
cursor:pointer;
}

.info{
margin-top:15px;
font-size:14px;
color:#555;
}

</style>

</head>

<body>

<div class="login-box">

<h2>Live Chat Login</h2>

<form action="/login" method="POST">

<input
type="text"
name="username"
placeholder="Username"
required
>

<input
type="password"
name="password"
placeholder="Password"
required
>

<button type="submit">
Login
</button>

</form>

<div class="info">
Admin: admin / 12345 <br>
User: user / 123
</div>

</div>

</body>
</html>