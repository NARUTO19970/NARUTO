<!DOCTYPE html>
<html>

<head>

<title>Admin Chat</title>

<script src="/socket.io/socket.io.js"></script>

<style>

body{
margin:0;
font-family:Arial;
background:#ece5dd;
}

.chat-container{
width:400px;
height:90vh;
background:white;
margin:20px auto;
display:flex;
flex-direction:column;
border-radius:10px;
overflow:hidden;
}

.chat-header{
background:#075E54;
color:white;
padding:15px;
font-size:20px;
display:flex;
justify-content:space-between;
}

.chat-box{
flex:1;
overflow-y:auto;
padding:10px;
display:flex;
flex-direction:column;
}
.message{
padding:8px 12px;
margin:5px 0;
border-radius:10px;
max-width:65%;
width:fit-content;
word-wrap:break-word;
font-size:14px;
}

.admin{
background:#DCF8C6;
margin-left:auto;
}

.user{
background:white;
border:1px solid #ddd;
}

.chat-input{
display:flex;
padding:10px;
gap:5px;
background:#f0f0f0;
}

#msg{
flex:1;
padding:10px;
border:none;
border-radius:20px;
outline:none;
}

button{
border:none;
background:#075E54;
color:white;
padding:10px 15px;
border-radius:50%;
cursor:pointer;
}

#image{
display:none;
}
img{
width:180px;
border-radius:10px;
margin-top:5px;
}
audio{
width:180px;
margin-top:5px;
}

.typing{
font-size:12px;
padding-left:10px;
color:gray;
}

</style>

</head>

<body>

<div class="chat-container">

<div class="chat-header">

<span>Admin Chat</span>

<span>
👥 <span id="onlineCount">0</span>
</span>

</div>

<div class="chat-box" id="messages"></div>

<div class="typing" id="typing"></div>

<div class="chat-input">

<button onclick="document.getElementById('image').click()">
📎
</button>

<input type="file" id="image">

<button id="recordBtn">🎤</button>

<input type="text" id="msg">

<button onclick="sendMessage()">➤</button>

</div>

</div>

<script>

const socket = io();

let mediaRecorder;

let audioChunks=[];

const msgInput =
document.getElementById("msg");

function sendMessage(){

let msg = msgInput.value;

if(msg.trim()!=""){

socket.emit(
"newMessage",
{
message:msg,
time:new Date().toLocaleTimeString(),
sender:"admin"
}
);

msgInput.value="";

}

}

msgInput.addEventListener("keyup",()=>{

socket.emit("typing");

});

document
.getElementById("image")
.addEventListener("change",function(){

let file=this.files[0];

let reader=new FileReader();

reader.onload=()=>{

socket.emit(
"newImage",
{
image:reader.result,
time:new Date().toLocaleTimeString(),
sender:"admin"
}
);

};

reader.readAsDataURL(file);

});

document
.getElementById("recordBtn")
.addEventListener("click",async()=>{

if(!mediaRecorder){

let stream=
await navigator.mediaDevices.getUserMedia({
audio:true
});

mediaRecorder=
new MediaRecorder(stream);

mediaRecorder.start();

audioChunks=[];

mediaRecorder.ondataavailable=(e)=>{

audioChunks.push(e.data);

};

mediaRecorder.onstop=()=>{

let blob=
new Blob(audioChunks,{
type:"audio/webm"
});

let reader=
new FileReader();

reader.onloadend=()=>{

socket.emit(
"newVoice",
{
audio:reader.result,
time:new Date().toLocaleTimeString(),
sender:"admin"
}
);

};

reader.readAsDataURL(blob);

};

document
.getElementById("recordBtn")
.innerText="⏹";

}else{

mediaRecorder.stop();

mediaRecorder=null;

document
.getElementById("recordBtn")
.innerText="🎤";

}

});

socket.on("newMessage",(data)=>{

let div=
document.createElement("div");

div.classList.add("message");

if(data.sender==="admin"){

div.classList.add("admin");

}else{

div.classList.add("user");

}

div.innerHTML=
`
${data.message}

<br>

<small>${data.time}</small>
`;

messages.appendChild(div);

});

socket.on("newImage",(data)=>{

let div=
document.createElement("div");

div.classList.add("message");

if(data.sender==="admin"){

div.classList.add("admin");

}else{

div.classList.add("user");

}

div.innerHTML=
`
<img src="${data.image}">

<br>

<small>${data.time}</small>
`;

messages.appendChild(div);

});

socket.on("newVoice",(data)=>{

let div=
document.createElement("div");

div.classList.add("message");

if(data.sender==="admin"){

div.classList.add("admin");

}else{

div.classList.add("user");

}

div.innerHTML=
`
<audio controls>
<source src="${data.audio}">
</audio>

<br>

<small>${data.time}</small>
`;

messages.appendChild(div);

});

socket.on("typing",(msg)=>{

document
.getElementById("typing")
.innerText=msg;

setTimeout(()=>{

document
.getElementById("typing")
.innerText="";

},1000);

});

socket.on("onlineUsers",(count)=>{

document
.getElementById("onlineCount")
.innerText=count;

});

</script>

</body>
</html>