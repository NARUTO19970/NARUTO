<!DOCTYPE html>
<html>

<head>

<title>Admin Chat</title>

<script src="/socket.io/socket.io.js"></script>

<style>

body{
margin:0;
font-family:Arial;
background:#ece5dd;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
}

.chat-container{
width:400px;
height:90vh;
background:white;
display:flex;
flex-direction:column;
border-radius:15px;
overflow:hidden;
}

.chat-header{
background:#075E54;
color:white;
padding:15px;
display:flex;
justify-content:space-between;
}

.chat-box{
flex:1;
overflow-y:auto;
padding:10px;
display:flex;
flex-direction:column;
}

.message{
padding:10px;
margin:5px 0;
border-radius:10px;
max-width:75%;
word-wrap:break-word;
}

.admin{
background:#DCF8C6;
margin-left:auto;
}

.user{
background:white;
border:1px solid #ccc;
}

.time{
font-size:11px;
margin-top:5px;
text-align:right;
opacity:0.7;
}

.seen{
font-size:11px;
color:blue;
text-align:right;
}

.chat-input{
display:flex;
padding:10px;
background:#f0f0f0;
gap:5px;
}

#msg{
flex:1;
padding:10px;
border:none;
border-radius:20px;
outline:none;
}

button{
border:none;
background:#075E54;
color:white;
padding:10px 15px;
border-radius:50%;
cursor:pointer;
}

#typing{
font-size:12px;
padding-left:10px;
color:gray;
height:20px;
}

audio{
width:100%;
margin-top:5px;
}

img{
max-width:100%;
border-radius:10px;
margin-top:5px;
}

</style>

</head>

<body>

<div class="chat-container">

<div class="chat-header">
<span>Admin Chat</span>
<span>👥 <span id="onlineCount">0</span></span>
</div>

<div id="typing"></div>

<div class="chat-box" id="messages"></div>

<div class="chat-input">

<input
type="text"
id="msg"
placeholder="Type message..."
>

<input type="file" id="file">

<button onclick="sendMessage()">➤</button>

</div>

</div>

<script>

const socket = io();

const messages =
document.getElementById("messages");

const msgInput =
document.getElementById("msg");

const fileInput =
document.getElementById("file");

// SEND MESSAGE
function sendMessage(){

let msg = msgInput.value;

if(msg.trim()!=""){

socket.emit("newMessage",{
message:msg,
sender:"admin"
});

msgInput.value="";

}

}

// ENTER
msgInput.addEventListener("keypress",(e)=>{

socket.emit("typing","Admin typing...");

if(e.key==="Enter"){
sendMessage();
}

});

// FILE UPLOAD
fileInput.addEventListener("change",()=>{

const file = fileInput.files[0];

const reader = new FileReader();

reader.onload = function(){

socket.emit("fileUpload",{
file:reader.result,
sender:"admin"
});

};

reader.readAsDataURL(file);

});

// RECEIVE MESSAGE
socket.on("newMessage",(data)=>{

let div = document.createElement("div");

div.classList.add("message");

if(data.sender==="admin"){
div.classList.add("admin");
}else{
div.classList.add("user");
}

div.innerHTML=`
<div>${data.message}</div>
<div class="time">${data.time}</div>
<div class="seen">${data.seen}</div>
`;

messages.appendChild(div);

messages.scrollTop=messages.scrollHeight;

});

// RECEIVE FILE
socket.on("fileUpload",(data)=>{

let div = document.createElement("div");

div.classList.add("message");

if(data.sender==="admin"){
div.classList.add("admin");
}else{
div.classList.add("user");
}

div.innerHTML=`
<img src="${data.file}">
`;

messages.appendChild(div);

messages.scrollTop=messages.scrollHeight;

});

// ONLINE
socket.on("onlineUsers",(count)=>{

document.getElementById("onlineCount").innerText=count;

});

// TYPING
socket.on("typing",(msg)=>{

document.getElementById("typing").innerText=msg;

setTimeout(()=>{
document.getElementById("typing").innerText="";
},1000);

});

</script>

</body>
</html>